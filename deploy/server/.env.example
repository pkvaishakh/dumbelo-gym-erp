# Copy to .env on the server (cp .env.example .env; chmod 600 .env) and fill in. Never commit .env.
# Keep a copy of the finished file somewhere safe off the server, like a password manager (docs/deploy-server.md).

# The two addresses. Point both at the server's public IP (DNS A records) before the first start.
# No domain yet? api.<ip with dashes>.sslip.io works, e.g. api.140-238-10-20.sslip.io and app.140-238-10-20.sslip.io.
API_DOMAIN=api.example.com
APP_DOMAIN=app.example.com
# Let's Encrypt writes here if a certificate is about to run out.
ACME_EMAIL=you@example.com

# The landing page at https://APP_DOMAIN/. Built into the web app, so after changing either run `bash update.sh`.
# Sales' email: Book a Demo and the footer show it to gym owners.
CONTACT_EMAIL=sales@example.com
# Sales' WhatsApp number (98765 43210 is enough). Every Chat on WhatsApp button appears once it's set: remove the #.
# SALES_WHATSAPP=98765 43210

# Make each one on the server; the guide has a command that fills all three in.
# Postgres's password:        openssl rand -hex 24
POSTGRES_PASSWORD=
# Signs the sign-in tokens. Changing it signs everyone out.     openssl rand -hex 50
SECRET_KEY=
# Encrypts the WhatsApp credentials in the database. Losing it loses them.   openssl rand -base64 32 | tr '+/' '-_'
FIELD_ENCRYPTION_KEY=

# `fake` sends nothing. Set whatsapp_cloud once a WhatsApp account is added in the Console (docs/deploy.md, step 3).
WHATSAPP_PROVIDER=fake
