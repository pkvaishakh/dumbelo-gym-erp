# Copy to .env and change for your machine.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgres://rackline:rackline@localhost:5432/rackline
# Servers: PRODUCTION=true, DEBUG=False, a real SECRET_KEY, and CACHE_URL=redis://... with more than one worker.
PRODUCTION=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
