# Copy to .env and change for your machine.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgres://rackline:rackline@localhost:5432/rackline
# Servers set PRODUCTION=true, which refuses to start without SECRET_KEY, ALLOWED_HOSTS, DATABASE_URL and
# CACHE_URL (redis://..., so every gunicorn worker shares the rate-limit counts). Full list: docs/deploy.md.
PRODUCTION=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Background jobs. Empty means no worker: jobs run where they are called, which is fine on a laptop.
# With Docker running, use redis://localhost:6379/0 and start the worker and beat (see README.md).
CELERY_BROKER_URL=
# Reminders to members. `fake` keeps what it would have sent in memory and calls nothing, which is what a
# laptop wants. A server that really sends: WHATSAPP_PROVIDER=whatsapp_cloud with the number's own keys.
WHATSAPP_PROVIDER=fake
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
CORS_ALLOWED_ORIGINS=http://localhost:3000
