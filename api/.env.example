# Copy to .env and change for your machine.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgres://rackline:rackline@localhost:5432/rackline
# Servers set PRODUCTION=true, which refuses to start without SECRET_KEY, ALLOWED_HOSTS, DATABASE_URL,
# CACHE_URL (redis://..., so every gunicorn worker shares the rate-limit counts) and FIELD_ENCRYPTION_KEY.
# Full list: docs/deploy.md.
PRODUCTION=False
ALLOWED_HOSTS=localhost,127.0.0.1
# Background jobs. Empty means no worker: jobs run where they are called, which is fine on a laptop.
# With Docker running, use redis://localhost:6379/0 and start the worker and beat (see README.md).
CELERY_BROKER_URL=
# WhatsApp. `fake` keeps what it would have sent in memory and calls nothing, which is what a laptop wants.
# A server that really sends sets WHATSAPP_PROVIDER=whatsapp_cloud (Meta's Cloud API). The numbers, their keys and
# their approved templates are added in the
# Console (WhatsApp), not here: Rackline's shared number is one of them.
WHATSAPP_PROVIDER=fake
WHATSAPP_API_VERSION=v23.0
# Encrypts the WhatsApp credentials in the database. Empty on a laptop means a fixed dev-only key; servers must
# set their own (PRODUCTION=true refuses to start without it). Comma-separated, newest first, to rotate it.
# Make one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000
